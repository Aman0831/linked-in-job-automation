# ─────────────────────────────────────────────────────────────
# LinkedIn Job Automation — Environment Configuration
# Copy this file to config/.env and fill in your real values.
# NEVER commit config/.env to version control.
# ─────────────────────────────────────────────────────────────

# ── LinkedIn Credentials ──────────────────────────────────────
LINKEDIN_EMAIL=your.linkedin@email.com
LINKEDIN_PASSWORD=YourLinkedInPassword

# ── Search Settings ───────────────────────────────────────────
SEARCH_KEYWORD_1=JAVA DEVELOPER
SEARCH_KEYWORD_2=CONTRACT
MAX_RESULTS=20

# ── Gmail Credentials (choose Option A or Option B) ───────────

# Option A: App Password (simpler)
# Create at: https://myaccount.google.com/apppasswords
GMAIL_EMAIL=your.gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Option B: OAuth2 (more robust for production)
# GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret
# GMAIL_REFRESH_TOKEN=your-refresh-token

# ── Candidate Info (used in email signature) ──────────────────
CANDIDATE_NAME=John Doe
CANDIDATE_PHONE=+1-555-123-4567

# ── Browser Settings ──────────────────────────────────────────
# Set to "false" to watch the browser run (useful for debugging)
HEADLESS=true
